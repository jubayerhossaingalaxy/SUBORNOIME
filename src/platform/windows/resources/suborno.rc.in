#include <windows.h>

#define IDI_SUBORNO 101
IDI_SUBORNO ICON "@SUBORNO_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @SUBORNO_FILE_TYPE@
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Suborno Project\0"
            VALUE "FileDescription", "@SUBORNO_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "@SUBORNO_INTERNAL_NAME@\0"
            VALUE "OriginalFilename", "@SUBORNO_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "Suborno\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
