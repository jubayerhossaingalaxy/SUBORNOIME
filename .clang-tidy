# SUBORNOIME - Professional clang-tidy policy
# Language: C++20
# Platform: Windows 10/11 x64, Win32, COM, TSF
# Compiler pipeline: MSVC (cl.exe); clang-tidy is a separate static-analysis tool.
# Target toolchain: LLVM/Clang-Tidy 23.1.x
#
# Policy:
# - Enable bug detection, static analysis, security and performance checks.
# - Keep modernization focused on safe, broadly applicable C++ practices.
# - Avoid highly opinionated style checks and rules that conflict with Win32/COM/C ABI.
# - Do not treat existing warnings as errors until the baseline has been reviewed and cleaned.

---

Checks:
  # Start from an explicit, reproducible check set.
  - '-*'

  # Static analyzer: null dereferences, lifetime, memory, logic and security paths.
  - 'clang-analyzer-*'

  # Likely programming mistakes and suspicious constructs.
  - 'bugprone-*'

  # CERT secure-coding recommendations.
  - 'cert-*'

  # Thread-safety and concurrency mistakes.
  - 'concurrency-*'

  # Runtime and API performance problems.
  - 'performance-*'

  # Selected C++ Core Guidelines checks that fit a native C++ codebase.
  - 'cppcoreguidelines-avoid-goto'
  - 'cppcoreguidelines-init-variables'
  - 'cppcoreguidelines-interfaces-global-init'
  - 'cppcoreguidelines-misleading-capture-default-by-value'
  - 'cppcoreguidelines-prefer-member-initializer'
  - 'cppcoreguidelines-pro-bounds-avoid-unchecked-container-access'
  - 'cppcoreguidelines-pro-bounds-constant-array-index'
  - 'cppcoreguidelines-pro-type-member-init'
  - 'cppcoreguidelines-slicing'
  - 'cppcoreguidelines-special-member-functions'
  - 'cppcoreguidelines-virtual-class-destructor'

  # Safe, broadly useful C++ modernization checks.
  - 'modernize-deprecated-headers'
  - 'modernize-make-shared'
  - 'modernize-make-unique'
  - 'modernize-redundant-void-arg'
  - 'modernize-use-bool-literals'
  - 'modernize-use-default-member-init'
  - 'modernize-use-emplace'
  - 'modernize-use-equals-default'
  - 'modernize-use-equals-delete'
  - 'modernize-use-nodiscard'
  - 'modernize-use-nullptr'
  - 'modernize-use-override'
  - 'modernize-use-scoped-lock'
  - 'modernize-use-uncaught-exceptions'
  - 'modernize-use-using'

  # Focused readability checks; avoid arbitrary naming/size rules.
  - 'readability-braces-around-statements'
  - 'readability-container-size-empty'
  - 'readability-delete-null-pointer'
  - 'readability-else-after-return'
  - 'readability-inconsistent-declaration-parameter-name'
  - 'readability-isolate-declaration'
  - 'readability-redundant-control-flow'
  - 'readability-simplify-boolean-expr'
  - 'readability-static-accessed-through-instance'
  - 'readability-uniqueptr-delete-release'

  # Focused miscellaneous correctness and maintainability checks.
  - 'misc-confusable-identifiers'
  - 'misc-definitions-in-headers'
  - 'misc-explicit-constructor'
  - 'misc-header-include-cycle'
  - 'misc-misleading-bidirectional'
  - 'misc-misleading-identifier'
  - 'misc-misplaced-const'
  - 'misc-new-delete-overloads'
  - 'misc-redundant-expression'
  - 'misc-static-assert'
  - 'misc-throw-by-value-catch-by-reference'
  - 'misc-unconventional-assign-operator'
  - 'misc-uniqueptr-reset-release'
  - 'misc-unused-alias-decls'
  - 'misc-unused-using-decls'

  # Avoid checks that are inappropriate or too opinionated for this project.
  # Win32/COM and the public C API legitimately use C arrays and low-level casts.
  - '-modernize-avoid-c-arrays'
  - '-modernize-use-auto'
  - '-modernize-use-noexcept'
  - '-modernize-use-ranges'
  - '-modernize-use-std-format'
  - '-modernize-use-std-print'
  - '-modernize-use-trailing-return-type'
  - '-cppcoreguidelines-pro-bounds-array-to-pointer-decay'
  - '-cppcoreguidelines-pro-bounds-pointer-arithmetic'
  - '-cppcoreguidelines-pro-type-cstyle-cast'
  - '-cppcoreguidelines-pro-type-reinterpret-cast'

WarningsAsErrors: ''

# Analyze project headers, but do not report diagnostics originating in generated,
# dependency, package-manager or build output directories.
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '(^|.*[/\\])(build|out|vcpkg_installed|third_party|external|generated)([/\\].*|$)'

# Keep diagnostics in SDK/system headers out of the project's warning stream.
SystemHeaders: false

# Match common project C/C++ source and header extensions, including templates.
HeaderFileExtensions:
  - ''
  - 'h'
  - 'hh'
  - 'hpp'
  - 'hxx'
  - 'inl'
  - 'ipp'
  - 'tpp'

ImplementationFileExtensions:
  - 'c'
  - 'cc'
  - 'cpp'
  - 'cxx'

# Apply the repository's companion .clang-format when clang-tidy applies a fix.
FormatStyle: file

# Keep this repository's policy self-contained instead of inheriting parent configs.
InheritParentConfig: false

UseColor: true
